{
  "_doc": {
    "說明": "45 張卡的資料來源映射表。ABS 的 SDMX key 已於 2026-08-15 逐一實打驗證回傳唯一序列。",
    "source 型別": {
      "abs": "ABS Data API（SDMX，免金鑰）。dataflow + key 指定單一序列",
      "abs_derived": "由多條 ABS 序列相減得出",
      "rba": "RBA 統計表 CSV（固定檔名，免金鑰）",
      "aofm": "AOFM Data Hub 的 xlsx/csv。⚠️ 站台有 Akamai 機器人偵測，走 common.get_impersonated",
      "html": "解析官方網頁 HTML",
      "manual": "人工輸入（data/manual.json）"
    },
    "ABS key 格式": "維度值以 . 相接，順序見各 dataflow 的 DSD；留空代表該維度取全部。常用碼：REGION AUS 或 50=全澳、SEX 3=合計、AGE 1599=15歲以上、TSEST 10=原始 20=季調、SECTOR 7=公私合計 1=私 2=公",
    "filter": "安全網。ABS 偶爾在 dataflow 加新維度，原本唯一的 key 會突然回傳多條序列——有 filter 才擋得下來，否則程式會默默挑一條當答案",
    "display": "level=原值 | yoy=年增率 | mom=月變動% | mom_diff=月變動絕對量 | qoq=季變動% | qoq_diff=季變動絕對量",
    "bond_dir": "值上升對債市的意義：1=利空（殖利率上行壓力）、-1=利多。依配色慣例紅=利多債市、綠=利空債市，以債券價格為準",
    "stale_days": "超過此天數未更新即亮黃燈（含資料本身的發布滯後）。ABS 月頻約 45、季頻約 115"
  },

  "monthly_cpi_indicator":            {"source":"abs","dataflow":"CPI","key":"3.10001.10.50.M","filter":{"MEASURE":"3","INDEX":"10001","FREQ":"M"},"bond_dir":1,"display":"level","unit":"%","decimals":1,"stale_days":45,"sanity":{"min":-3,"max":15},"value_label":"月度 · 年增率","note":"月度口徑，非 RBA 政策溝通的正式引用版"},
  "monthly_trimmed_mean_cpi":         {"source":"abs","dataflow":"CPI","key":"3.999902.20.50.M","filter":{"MEASURE":"3","INDEX":"999902","FREQ":"M"},"bond_dir":1,"display":"level","unit":"%","decimals":1,"stale_days":45,"sanity":{"min":-2,"max":12},"value_label":"月度核心 · 年增率"},
  "quarterly_cpi":                    {"source":"abs","dataflow":"CPI","key":"1.10001.10.50.Q","filter":{"MEASURE":"1","INDEX":"10001","FREQ":"Q"},"bond_dir":1,"display":"yoy","also":["qoq"],"also_labels":{"qoq":"季增率"},"unit":"%","decimals":1,"stale_days":170,"label_as":"quarter","sanity":{"min":-3,"max":15},"value_label":"季度 · 年增率（RBA 正式引用版）","note":"CPI_Q 裡沒有 headline 全澳總指數，只能從指數值自算年增率"},
  "quarterly_trimmed_mean_cpi":       {"source":"abs","dataflow":"CPI_Q","key":"3.999902.20.50.Q","filter":{"MEASURE":"3","INDEX":"999902"},"bond_dir":1,"display":"level","unit":"%","decimals":1,"stale_days":170,"label_as":"quarter","sanity":{"min":-2,"max":12},"value_label":"季度核心 · 年增率（RBA 首選）"},
